{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "database": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": { "size": { "type": "string", "minLength": 1 }, "storageClass": { "type": "string" } }
    }
  }
}
